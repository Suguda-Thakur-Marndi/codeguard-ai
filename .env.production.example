# ==============================================================================
# CodeGuard AI — Production Environment Configuration Template
# ==============================================================================

# Application Environment: MUST be 'production'
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# Service URLs
BACKEND_URL=https://api.codeguard.ai
FRONTEND_URL=https://app.codeguard.ai
NEXT_PUBLIC_API_URL=https://api.codeguard.ai/api/v1

# Production PostgreSQL Database Connection
# Dedicated cluster with connection pooling, encryption at rest and in transit
DATABASE_URL=postgresql://codeguard_prod:PROD_SECURE_PASSWORD@prod-postgres-cluster:5432/codeguard_prod?sslmode=require
POSTGRES_USER=codeguard_prod
POSTGRES_PASSWORD=PROD_SECURE_PASSWORD
POSTGRES_DB=codeguard_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# Production Redis Connection (Encrypted cluster with password authentication)
REDIS_URL=rediss://:PROD_REDIS_PASSWORD@prod-redis-cluster:6379/0
REDIS_PASSWORD=PROD_REDIS_PASSWORD

# GitHub App Integration Credentials (Production Verified GitHub App)
GITHUB_APP_ID=PROD_GITHUB_APP_ID
GITHUB_CLIENT_ID=PROD_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=PROD_GITHUB_CLIENT_SECRET
GITHUB_WEBHOOK_SECRET=PROD_GITHUB_WEBHOOK_SECRET_AT_LEAST_32_BYTES

# GitHub App Private Key (PEM format RSA private key)
# Ensure newlines are preserved or formatted as \n
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Review Job & Webhook Settings
IGNORE_DRAFT_PRS=false
CELERY_TASK_ALWAYS_EAGER=false

# Production Gemini AI Provider & Cost Controls
GEMINI_API_KEY=PROD_GEMINI_API_KEY
LLM_PROVIDER=gemini
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro

# Concurrency & Token Budgets
AGENT_MAX_CONCURRENCY=4
AGENT_MAX_RETRIES=2
AGENT_TIMEOUT_SECONDS=60.0
MAX_CONTEXT_CHARS=16000
MAX_CONTEXT_FILES=10
MAX_CONTEXT_SYMBOLS=30

# MCP Server Zero-Trust Gateway Configuration
MCP_SERVER_URL=http://mcp-server:8001
MCP_SERVICE_TOKEN=PROD_MCP_SERVICE_TOKEN_AT_LEAST_32_BYTES
MCP_CORS_ORIGINS=https://api.codeguard.ai,https://app.codeguard.ai
APPROVAL_EXPIRY_MINUTES_DEFAULT=60

# Production Security & Session Encryption (DEV BYPASS FORBIDDEN)
SECRET_KEY=PROD_SECRET_KEY_AT_LEAST_32_BYTES
DEV_AUTH_BYPASS=false
DEV_AUTH_TOKEN=
CORS_ORIGINS=https://app.codeguard.ai,https://api.codeguard.ai

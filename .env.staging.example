# ==============================================================================
# CodeGuard AI — Staging Environment Configuration Template
# ==============================================================================

# Application Environment: MUST be 'staging'
APP_ENV=staging
LOG_LEVEL=INFO
DEBUG=false

# Service URLs
BACKEND_URL=https://api-staging.codeguard.internal
FRONTEND_URL=https://dashboard-staging.codeguard.internal
NEXT_PUBLIC_API_URL=https://api-staging.codeguard.internal/api/v1

# Staging PostgreSQL Database Connection (ISOLATED from Production)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://codeguard_staging:CHANGE_ME_STAGING_PASSWORD@staging-db:5432/codeguard_staging
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Staging Redis Connection (ISOLATED from Production)
REDIS_URL=redis://:CHANGE_ME_STAGING_REDIS_PASSWORD@staging-redis:6379/0
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD

# GitHub App Integration Credentials (Dedicated Staging App instance)
# NEVER reuse production GitHub App in staging.
GITHUB_APP_ID=STAGING_APP_ID_HERE
GITHUB_CLIENT_ID=STAGING_CLIENT_ID_HERE
GITHUB_CLIENT_SECRET=STAGING_CLIENT_SECRET_HERE
GITHUB_WEBHOOK_SECRET=STAGING_WEBHOOK_SECRET_HERE

# GitHub App Private Key (PEM format RSA private key)
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Review Job & Webhook Settings
IGNORE_DRAFT_PRS=true
CELERY_TASK_ALWAYS_EAGER=false

# AI Provider Configuration
GEMINI_API_KEY=STAGING_GEMINI_API_KEY_HERE
LLM_PROVIDER=gemini
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro

# MCP Server Gateway Configuration
MCP_SERVER_URL=http://mcp-server:8001
MCP_SERVICE_TOKEN=GENERATE_WITH_OPENSSL_RAND_HEX_32
MCP_CORS_ORIGINS=https://api-staging.codeguard.internal,https://dashboard-staging.codeguard.internal

# Security & Authentication (DEV BYPASS STRICTLY DISABLED)
SECRET_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
DEV_AUTH_BYPASS=false
DEV_AUTH_TOKEN=
CORS_ORIGINS=https://dashboard-staging.codeguard.internal,https://api-staging.codeguard.internal
